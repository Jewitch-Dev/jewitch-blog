---
layout: layouts/base.njk
title: Home
permalink: /
---

<h1>jewitch.blog</h1>

<p>
  An independent home on the open web.
</p>

<section>
  <h2>Writing</h2>

  {% if collections.posts.length %}
    <ul>
    {% for post in collections.posts %}
      <li>
        <a href="{{ post.url }}">
          {{ post.data.title }}
        </a>
      </li>
    {% endfor %}
    </ul>
  {% else %}
    <p>No articles yet.</p>
  {% endif %}
</section>

<section>
  <h2>Notes</h2>

  {% if collections.notes.length %}
    <ul>
    {% for note in collections.notes %}
      <li>
        <a href="{{ note.url }}">
          {{ note.date.toISOString() }}
        </a>
      </li>
    {% endfor %}
    </ul>
  {% else %}
    <p>No notes yet.</p>
  {% endif %}
</section>
