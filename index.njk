---
layout: layouts/base.njk
title: Home
description: An independent home on the open web.
permalink: /
---

<section class="hero">
  <div class="hero__copy">
    <h1>Words, notes,<br>and assorted <em>witchery.</em></h1>
    <p class="hero__intro">My little corner of the web, built by hand instead of rented from an algorithm.</p>
    <p class="eyebrow">Independent · personal · open web</p>
  </div>

  <div class="hero__art" aria-hidden="true">
    <img src="/assets/hero-cat.jpg" alt="">
  </div>

  <blockquote class="hero__aside">A quieter,<br><em>kinder</em> web is<br>still possible.<span>✦</span></blockquote>
</section>

<div class="home-content-grid">
  <section class="home-section home-section--writing">
    <div class="section-heading">
      <div><p class="section-kicker">Longer thoughts</p><h2>Latest writing</h2></div>
      <a href="/posts/">All writing →</a>
    </div>

    {% if collections.posts.length %}
      <div class="post-list h-feed">
        {% for post in collections.posts %}{% if loop.index <= 3 %}
          <article class="post-summary h-entry">
            <time class="dt-published" datetime="{{ post.date | isoDateTime }}">{{ post.date | readableDate }}</time>
            <div><h3 class="p-name"><a class="u-url" href="{{ post.url }}">{{ post.data.title }}</a></h3>{% if post.data.description %}<p class="p-summary">{{ post.data.description }}</p>{% endif %}</div>
          </article>
        {% endif %}{% endfor %}
      </div>
    {% else %}
      <div class="empty-state"><p>No long-form writing yet. The blank page is staring back.</p></div>
    {% endif %}
  </section>

  <aside class="toot-sidebar" aria-labelledby="toot-sidebar-title">
    <div class="toot-sidebar__header">
      <div><p class="section-kicker">From the Fediverse</p><h2 id="toot-sidebar-title">Latest toots</h2></div>
      <a class="toot-sidebar__all" href="/notes/">All notes →</a>
    </div>
    {% if collections.notes.length %}
      <div class="toot-list h-feed">
        {% for note in collections.notes %}{% if loop.index <= 5 %}
          <article class="toot-summary h-entry">
            <div class="toot-summary__content e-content">{{ note.templateContent | safe }}</div>
            <a class="toot-summary__date u-url" href="{{ note.url }}"><time class="dt-published" datetime="{{ note.date | isoDateTime }}">{{ note.date | readableDateTime }}</time></a>
          </article>
        {% endif %}{% endfor %}
      </div>
    {% else %}<p class="empty-state">No toots yet.</p>{% endif %}
  </aside>
</div>
