---
layout: layouts/base.njk
title: Writing
permalink: /posts/
---

<header class="page-header">
  <p class="eyebrow">Long-form dispatches</p>
  <h1>Writing</h1>

  <p>
    Essays, arguments, explorations, and anything else that needed
    more room than a note.
  </p>
</header>

{% if collections.posts.length %}

  <div class="post-list h-feed">
    {% for post in collections.posts %}
      <article class="post-summary h-entry">
        <time class="dt-published" datetime="{{ post.date | isoDateTime }}">
          {{ post.date | readableDate }}
        </time>

        <h2 class="p-name">
          <a class="u-url" href="{{ post.url }}">{{ post.data.title }}</a>
        </h2>

        {% if post.data.description %}
          <p class="p-summary">{{ post.data.description }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>

{% else %}

  <p class="empty-state">
    No long-form writing yet. The blank page is staring back.
  </p>

{% endif %}
